PORT=3000
# auto: API 설정이 있으면 Claude API, 아니면 로그인된 Claude CLI 사용.
# 명시적 선택: anthropic / claude-cli / demo
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# CLI 경로와 모델은 생략하면 설치 경로/계정 기본 모델 사용
CLAUDE_CLI_PATH=
CLAUDE_MODEL=
# 운영자 계정 생성: 아래 값 설정 후 npm.cmd run admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# HTTPS로 운영할 때만 true
COOKIE_SECURE=false
